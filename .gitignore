# macOS
.DS_Store

# Xcode — user-specific state (per-developer, never share)
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Xcode Cloud — per-checkout workspace manifest. Worth stating why, because
# it sits inside xcshareddata/, which is otherwise shared deliberately (the
# schemes there are tracked): this file only maps THIS checkout's workspace to
# a workflow target id, Xcode regenerates it on demand, and it carries no
# setting anyone else needs. Contrast Package.resolved below, which is tracked
# precisely because Xcode Cloud does need it.
Murmur.xcodeproj/xcshareddata/xcodecloud/

# Xcode — build products / derived data
build/
DerivedData/
Products/
*.xcarchive
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
*.swiftpm/
# Package.resolved is intentionally tracked — Xcode Cloud requires it
# (automatic dependency resolution is disabled on hosted builds) and
# committing it pins SPM versions across the team.

# Pods / Carthage / other dep managers
Pods/
Carthage/Build/

# Logs / temp
*.log
*.tmp
*.swp
*.bak

# Test results / playgrounds
*.xctestrun
*.xcresult
*.playground/timeline.xctimeline

# Memory / agent artifacts (not part of the project)
memory/
