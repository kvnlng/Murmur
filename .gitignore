# macOS
.DS_Store

# Xcode — user-specific state (per-developer, never share)
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Xcode Cloud — per-checkout workspace manifest. Worth stating why, because
# it sits inside xcshareddata/, which is otherwise shared deliberately (the
# schemes there are tracked): this file only maps THIS checkout's workspace to
# a workflow target id, Xcode regenerates it on demand, and it carries no
# setting anyone else needs. Contrast Package.resolved below, which is tracked
# precisely because Xcode Cloud does need it.
Murmur.xcodeproj/xcshareddata/xcodecloud/

# Xcode — build products / derived data
build/
DerivedData/
Products/
*.xcarchive
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
*.swiftpm/
# Package.resolved is intentionally tracked — Xcode Cloud requires it
# (automatic dependency resolution is disabled on hosted builds) and
# committing it pins SPM versions across the team.

# Pods / Carthage / other dep managers
Pods/
Carthage/Build/

# Logs / temp
*.log
*.tmp
*.swp
*.bak

# Test results / playgrounds
*.xctestrun
*.xcresult
*.playground/timeline.xctimeline

# Credentials — never commit, this repo is public. App Store Connect API
# keys live in ~/.appstoreconnect/private_keys/ (see XCODE_CLOUD.md); these
# patterns exist so a key that strays into the working tree can't be added
# by a wildcard `git add`. Apple issues each .p8 exactly once — a leaked one
# must be revoked in App Store Connect, not rotated in place.
*.p8
AuthKey_*
issuer_id

# Same failure mode, neighbouring formats (#387): none of these has ever
# existed in this repo (verified across full history in the 2026-08-26
# openness audit) — the patterns are a fence, not a cleanup.
.env
.env.*
*.pem
*.key
*.p12
*.cer
*.mobileprovision
id_rsa*
*.keystore

# Memory / agent artifacts (not part of the project)
memory/

# Agent config dirs — previously ignored only by the machine-global git
# ignore, which does not travel to other clones or CI (#387).
.claude/
.superpowers/
